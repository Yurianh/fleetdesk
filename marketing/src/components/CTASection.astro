---
// Appel final des pages : une planche encadrée sur le papier, juste avant le
// pied de page gravé (qui porte déjà la rue : pas d'illustration ici).
---
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24">
  <div class="border border-plate-ink bg-white p-1.5 sm:p-2">
    <div class="border border-plate-ink px-6 sm:px-12 py-12 sm:py-16 grid lg:grid-cols-[1.25fr_0.75fr] gap-10 items-end">
      <div>
        <p class="text-[12.5px] font-semibold tracking-[0.14em] text-plate-ink mb-4">7 JOURS D'ESSAI, SANS CARTE</p>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-[-0.025em] leading-[1.08] text-plate-text mb-5" style="text-wrap: balance">
          Votre flotte mérite mieux qu'un tableur.
        </h2>
        <p class="text-lg text-plate-body max-w-xl">
          Opérationnel en 5 minutes. Sans formation, sans carte bancaire, sans prise de tête.
        </p>
      </div>
      <div class="flex flex-col items-start lg:items-end gap-4">
        <a href="/pricing" class="cta-brand inline-flex items-center gap-2.5 text-white font-semibold px-7 py-4 rounded-xl">
          Essayer gratuitement
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z"/></svg>
        </a>
        <a href="/contact" class="font-semibold text-plate-ink hover:underline underline-offset-4">Parler à l'équipe</a>
        <p class="text-[13px] text-plate-muted">Prévenu 48 h avant la fin · Sans engagement</p>
      </div>
    </div>
  </div>
  <p class="mt-2.5 text-[12.5px] tracking-[0.04em] text-plate-muted">DERNIÈRE PLANCHE · VOTRE FLOTTE</p>
</section>
