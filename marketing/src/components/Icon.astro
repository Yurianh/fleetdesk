---
import { ICONS, ICON_VIEWBOX } from '../lib/icons.js'

interface Props {
  name: keyof typeof ICONS
  size?: number
  class?: string
}
const { name, size = 20, class: cls = '' } = Astro.props
const path = ICONS[name]
if (!path) throw new Error(`Icône inconnue : ${name}`)
---
<svg
  width={size} height={size} viewBox={ICON_VIEWBOX} fill="currentColor"
  class={cls} aria-hidden="true" set:html={path}
/>
