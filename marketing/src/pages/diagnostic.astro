---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import Footer from '../components/Footer.astro'
import Diagnostic from '../components/Diagnostic.jsx'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://fleetdesk.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Diagnostic de flotte', item: 'https://fleetdesk.fr/diagnostic' },
  ],
}
---
<Layout
  title="Diagnostic de flotte : votre parc est-il exposé ?"
  description="Cinq questions, une minute : découvrez ce qui expose votre flotte à un contrôle raté, un document expiré ou une panne évitable, et ce qui changerait avec un suivi automatique."
  jsonLd={[breadcrumb]}
>
  <Navbar client:load currentPath="/diagnostic" />
  <section class="bg-white border-b border-zinc-100 pt-16 sm:pt-20 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-zinc-500 mb-8 flex items-center gap-1.5" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-[#0066FF]">Accueil</a><span>/</span>
        <span class="text-zinc-600">Diagnostic de flotte</span>
      </nav>
      <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Diagnostic gratuit · 1 minute</p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold text-zinc-900 tracking-tight leading-[1.05] mb-5">
        Votre flotte est-elle à l'abri d'un contrôle raté ?
      </h1>
      <p class="text-lg text-zinc-600 leading-relaxed mb-12">
        Cinq questions sur votre façon de suivre vos véhicules. À la fin, ce qui vous expose aujourd'hui, et ce que
        FleetDesk changerait concrètement dans votre cas. Sans inscription.
      </p>
      <Diagnostic client:load variant="full" />
    </div>
  </section>
  <Footer />
</Layout>
