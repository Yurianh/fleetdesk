---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import CTASection from '../components/CTASection.astro'
import Footer from '../components/Footer.astro'

const APP_URL = 'https://app.fleetdesk.fr'

const plans = [
  {
    name: 'Starter',
    monthlyPrice: '9',
    annualPrice: '70',
    period: '/mois',
    annualMonthly: '5,83',
    annualSaving: '38',
    desc: 'Pour les artisans et indépendants : piloter sa flotte et rester conforme, sans tableur.',
    badge: null,
    trialNote: '7 jours gratuits · Sans carte bancaire',
    features: [
      { text: 'Jusqu\'à 5 véhicules et 3 conducteurs' },
      { text: 'Documents conducteurs (7) et véhicule suivis' },
      { text: 'Alertes contrôles techniques et échéances' },
      { text: 'Prévisions d\'entretien et tableau de bord' },
      { text: 'Support par email' },
    ],
    cta: 'Démarrer l\'essai gratuit',
    ctaHref: `${APP_URL}/login?plan=starter`,
    ctaStyle: 'border',
    highlighted: false,
  },
  {
    name: 'Pro',
    monthlyPrice: '29',
    annualPrice: '220',
    period: '/mois',
    annualMonthly: '18,33',
    annualSaving: '128',
    desc: 'Pour les équipes en croissance qui ne peuvent pas se permettre un incident de conformité.',
    badge: 'Le plus populaire',
    trialNote: '7 jours gratuits · Sans carte bancaire',
    features: [
      { text: 'Jusqu\'à 25 véhicules · conducteurs illimités' },
      { text: 'Tout Starter, sans la limite de flotte' },
      { text: 'Alertes 30 jours avant chaque échéance' },
      { text: 'Prévisions de maintenance et analytics complets' },
      { text: 'Suivi des lavages et justificatifs' },
      { text: 'Support prioritaire' },
    ],
    cta: 'Démarrer l\'essai gratuit',
    ctaHref: `${APP_URL}/login?plan=pro`,
    ctaStyle: 'primary',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    monthlyPrice: '79',
    annualPrice: '600',
    period: '/mois',
    annualMonthly: '50',
    annualSaving: '348',
    desc: 'Pour les flottes qui font saisir le terrain : chauffeurs, équipe et traçabilité.',
    badge: null,
    trialNote: '7 jours gratuits · Sans carte bancaire',
    features: [
      { text: 'Véhicules et conducteurs illimités' },
      { text: 'Invitez votre équipe : admins et membres' },
      { text: 'Accès chauffeur : saisie km, pleins et factures depuis le terrain' },
      { text: 'Rôles et permissions appliqués côté serveur' },
      { text: 'Journal d\'activité complet, prêt pour les audits' },
      { text: 'Onboarding personnalisé et SLA garanti' },
    ],
    cta: 'Démarrer l\'essai gratuit',
    ctaHref: `${APP_URL}/login?plan=enterprise`,
    ctaStyle: 'border',
    highlighted: false,
  },
]

const faq = [
  {
    q: 'L\'essai est-il vraiment sans carte bancaire ?',
    a: 'Oui. 7 jours d\'accès complet à la formule de votre choix, sans carte bancaire. 48 h avant la fin, on vous prévient par e-mail. Vous choisissez de continuer, ou pas : rien n\'est prélevé sans votre accord, et arrêter ne coûte rien. Sans abonnement à la fin de l\'essai, votre compte passe en lecture seule : vos données restent consultables.'
  },
  {
    q: 'Puis-je changer de formule à tout moment ?',
    a: 'Oui. Passage à une formule supérieure ou inférieure depuis vos paramètres, à tout moment. Les modifications prennent effet au prochain cycle de facturation.'
  },
  {
    q: 'Que se passe-t-il si j\'atteins ma limite de véhicules ?',
    a: 'Vous êtes averti avant d\'atteindre la limite. Nous ne coupons jamais l\'accès sans prévenir : vous aurez toujours le temps de passer à une formule supérieure.'
  },
  {
    q: 'Mes chauffeurs peuvent-ils saisir eux-mêmes ?',
    a: 'Oui, avec la formule Enterprise. Vous invitez chaque chauffeur, qui reçoit un accès dédié limité à son véhicule pour saisir kilométrage, pleins et lavages depuis son téléphone. Les invitations d\'équipe (admins, membres, chauffeurs) sont incluses sur Enterprise.'
  },
  {
    q: 'Puis-je stocker les permis, assurances et cartes grises ?',
    a: 'Oui, sur toutes les formules. FleetDesk conserve les documents de vos conducteurs et véhicules, calcule leurs échéances et vous alerte avant expiration. Les fichiers sont stockés en privé, jamais en accès public.'
  },
  {
    q: 'La facturation annuelle est-elle disponible ?',
    a: 'Oui, et elle revient jusqu\'à 37 % moins cher que le mensuel : 70 €, 220 € ou 600 € par an selon la formule, payés en une fois. Choisissez « Annuel » au-dessus des formules. Le mensuel, lui, est sans engagement : vous arrêtez quand vous voulez, sans frais.'
  },
]

// Données structurées : offres tarifaires + FAQ, pour les résultats enrichis.
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'FleetDesk',
  description: 'Logiciel de gestion de flotte et de conformité pour les PME.',
  brand: { '@type': 'Brand', name: 'FleetDesk' },
  offers: plans.map(pl => ({
    '@type': 'Offer',
    name: pl.name,
    price: pl.monthlyPrice,
    priceCurrency: 'EUR',
    url: 'https://fleetdesk.fr/pricing',
    availability: 'https://schema.org/InStock',
  })),
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question', name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://fleetdesk.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Tarifs', item: 'https://fleetdesk.fr/pricing' },
  ],
}
---
<Layout
  title="Tarifs d'un logiciel de gestion de flotte"
  jsonLd={[productSchema, faqSchema, breadcrumb]}
  description="Dès 9 €/mois, 7 jours d'essai gratuit sans carte sur toutes les formules, prévenu 48 h avant la fin, sans engagement. Jusqu'à 37 % de moins en annuel."
>
  <Navbar client:load currentPath="/pricing" />

  <!-- Header -->
  <section class="bg-white border-b border-zinc-100 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Tarifs</p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold text-zinc-900 tracking-tight mb-5">
        Simple. Transparent. Sans surprise.
      </h1>
      <p class="text-lg text-zinc-600 max-w-xl mx-auto">
        7 jours d'essai sur toutes les formules, sans carte bancaire. On vous prévient 48 h avant la fin, et arrêter ne coûte rien.
      </p>
    </div>
  </section>

  <!-- Pricing cards -->
  <section id="plans" class="py-16 bg-zinc-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Billing toggle -->
      <div class="flex items-center justify-center mb-12">
        <div class="inline-flex bg-white border border-zinc-200 rounded-full p-1 shadow-sm">
          <button
            id="btn-annual"
            class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200 hover:text-zinc-800 flex items-center gap-2 bg-[#E5EEFF] text-[#0052D6]"
          >
            Annuel
            <span class="text-[11px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded-full">jusqu'à −37 %</span>
          </button>
          <button
            id="btn-monthly"
            class="px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200 text-zinc-600"
          >
            Mensuel
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        {plans.map(p => (
          <div class={`relative flex flex-col rounded-2xl p-7 ${p.highlighted ? 'border-2 border-[#0066FF] bg-white shadow-xl shadow-[#0066FF]/10 scale-[1.02]' : 'bg-white border border-zinc-200'}`}>

            {/* Badge */}
            {p.badge && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap">
                <span class="bg-[#0066FF] text-white text-xs font-semibold px-3 py-1 rounded-full">{p.badge}</span>
              </div>
            )}

            {/* Plan name + price */}
            <div class="mb-5">
              <p class={`text-xs font-medium uppercase tracking-widest mb-2 ${p.highlighted ? 'text-[#0066FF]' : 'text-zinc-500'}`}>{p.name}</p>
              <div class="flex items-end gap-1 mb-1">
                <span
                  class="price-amount text-4xl font-bold tracking-tight text-zinc-900 font-mono"
                  data-monthly={p.monthlyPrice}
                  data-annual={p.annualMonthly}
                >
                  {p.annualMonthly}
                </span>
                <span class="text-xl font-bold text-zinc-900 mb-0.5">€</span>
                <span class="text-sm mb-1.5 text-zinc-500">/mois</span>
              </div>
              {/* Annual subtotal line */}
              <p
                class="annual-total text-xs text-zinc-500"
              >
                facturé {p.annualPrice} € par an · {p.annualSaving} € d'économie
              </p>
              {p.trialNote && (
                <p class="text-xs text-emerald-700 mt-1">{p.trialNote}</p>
              )}
            </div>

            {/* Description */}
            <p class="text-sm text-zinc-600 leading-relaxed mb-6 pb-6 border-b border-zinc-100">{p.desc}</p>

            {/* Features */}
            <ul class="space-y-3 mb-8 flex-1">
              {p.features.map(f => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-[#0066FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="text-sm text-zinc-600">{f.text}</span>
                </li>
              ))}
            </ul>

            {/* CTA */}
            <a
              href={`${p.ctaHref}&billing=annual`}
              data-plan-cta
              class={`block w-full text-center text-sm font-medium px-5 py-3 rounded-xl transition-colors ${
                p.ctaStyle === 'primary'
                  ? 'bg-[#0066FF] text-white hover:bg-[#0052D6]'
                  : 'border border-zinc-200 text-zinc-700 hover:bg-zinc-50'
              }`}
            >
              {p.cta}
            </a>
          </div>
        ))}
      </div>

      <!-- Transparence de l'essai -->
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm">
        {[
          ['7 jours d\'essai', 'Sur toutes les formules, accès complet.'],
          ['Sans carte bancaire', 'Rien n\'est prélevé pendant l\'essai.'],
          ['Prévenu 48 h avant', 'Un e-mail avant la fin de l\'essai : vous décidez.'],
          ['Sans engagement', 'Mensuel résiliable à tout moment, sans frais.'],
        ].map(([t, d]) => (
          <div class="rounded-xl bg-white border border-zinc-200 px-4 py-3.5">
            <p class="font-semibold text-zinc-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {t}
            </p>
            <p class="text-zinc-500 text-xs mt-1 leading-relaxed">{d}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-zinc-500 mt-6">
        Données hébergées en Europe · Paiement sécurisé par Stripe · En démarrant l'essai, vous acceptez les
        <a href="/legal#cgu" class="underline underline-offset-2 hover:text-zinc-800">conditions générales</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-zinc-900 tracking-tight mb-10 text-center">Questions fréquentes</h2>
      <div class="space-y-0 divide-y divide-zinc-100">
        {faq.map(item => (
          <div class="py-6">
            <p class="font-semibold text-zinc-900 mb-2">{item.q}</p>
            <p class="text-sm text-zinc-600 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
  <Footer />
</Layout>

<script>
  const btnMonthly = document.getElementById('btn-monthly')
  const btnAnnual  = document.getElementById('btn-annual')
  const amounts    = document.querySelectorAll('.price-amount')
  const totals     = document.querySelectorAll('.annual-total')

  const ctas = document.querySelectorAll('a[data-plan-cta]')
  const setBilling = annual => ctas.forEach(a => {
    const url = new URL(a.href)
    url.searchParams.set('billing', annual ? 'annual' : 'monthly')
    a.href = url.toString()
  })

  function setMonthly() {
    setBilling(false)
    btnMonthly.classList.add('bg-[#E5EEFF]', 'text-[#0052D6]')
    btnMonthly.classList.remove('text-zinc-600')
    btnAnnual.classList.remove('bg-[#E5EEFF]', 'text-[#0052D6]')
    btnAnnual.classList.add('text-zinc-600')
    amounts.forEach(el => {
      el.textContent = el.dataset.monthly
    })
    totals.forEach(el => el.classList.add('hidden'))
  }

  function setAnnual() {
    setBilling(true)
    btnAnnual.classList.add('bg-[#E5EEFF]', 'text-[#0052D6]')
    btnAnnual.classList.remove('text-zinc-600')
    btnMonthly.classList.remove('bg-[#E5EEFF]', 'text-[#0052D6]')
    btnMonthly.classList.add('text-zinc-600')
    amounts.forEach(el => {
      el.textContent = el.dataset.annual
    })
    totals.forEach(el => el.classList.remove('hidden'))
  }

  btnMonthly.addEventListener('click', setMonthly)
  btnAnnual.addEventListener('click', setAnnual)
</script>
