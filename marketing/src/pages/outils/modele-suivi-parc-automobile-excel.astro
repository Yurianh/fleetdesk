---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.jsx'
import CTASection from '../../components/CTASection.astro'
import Footer from '../../components/Footer.astro'

const FILE = '/modele-suivi-parc-automobile-fleetdesk.xlsx'

const sheets = [
  {
    name: 'Véhicules',
    desc: "Une ligne par véhicule : immatriculation, genre, date de première mise en circulation, conducteur assigné, kilométrage, dernier et prochain contrôle technique, échéance d'assurance.",
    extra: "La colonne « jours restants » passe en orange sous 30 jours et en rouge une fois l'échéance dépassée.",
  },
  {
    name: 'Conducteurs',
    desc: "Permis et sa validité, visite médicale, FIMO et FCO, habilitations libres. Une colonne calcule l'échéance la plus proche pour chaque conducteur.",
    extra: "À réserver aux personnes habilitées : ces données sont personnelles.",
  },
  {
    name: 'Entretiens & dépenses',
    desc: "Une ligne par dépense rattachée à une immatriculation : entretien, réparation, pneus, carburant, avec montant et justificatif.",
    extra: "C'est cet historique qui rend le coût par véhicule comparable.",
  },
  {
    name: 'Coût par véhicule',
    desc: "Charges fixes, charges variables et kilométrage de la période : le coût de revient kilométrique se calcule tout seul.",
    extra: "La méthode complète est détaillée dans notre guide dédié.",
  },
]

const faq = [
  {
    q: 'Le modèle est-il vraiment gratuit ?',
    a: "Oui, et sans inscription : le fichier se télécharge directement, sans formulaire ni adresse email à laisser. Il est librement réutilisable et modifiable.",
  },
  {
    q: 'Quel logiciel faut-il pour ouvrir le fichier ?',
    a: "Le format .xlsx s'ouvre avec Microsoft Excel, Google Sheets, LibreOffice Calc ou Numbers. Les mises en forme conditionnelles et les formules de dates fonctionnent dans ces quatre outils.",
  },
  {
    q: "Le fichier m'alertera-t-il avant une échéance ?",
    a: "Non, et c'est sa limite principale : un tableur ne prévient personne. Les cellules changent de couleur, mais encore faut-il ouvrir le fichier. Au-delà de 5 véhicules, cette limite devient un vrai risque d'oubli.",
  },
  {
    q: 'Comment passer de ce fichier à FleetDesk ?',
    a: "En reprenant les mêmes colonnes dans l'application : immatriculation, dates d'échéance connues, conducteurs. Sur 10 à 20 véhicules, la saisie prend moins d'une heure, et les alertes sont actives immédiatement.",
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://fleetdesk.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Outils', item: 'https://fleetdesk.fr/outils/modele-suivi-parc-automobile-excel' },
  ],
}
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Modèle de suivi de parc automobile (Excel)',
  description: "Modèle Excel gratuit pour suivre véhicules, conducteurs, contrôles techniques et coûts. Quatre onglets prêts à l'emploi, sans inscription.",
  inLanguage: 'fr-FR',
  isAccessibleForFree: true,
  license: 'https://fleetdesk.fr/legal',
  author: { '@type': 'Organization', name: 'FleetDesk', url: 'https://fleetdesk.fr' },
  encodingFormat: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  url: 'https://fleetdesk.fr/outils/modele-suivi-parc-automobile-excel',
}
---
<Layout
  title="Modèle de suivi de parc automobile Excel (gratuit)"
  description="Modèle Excel gratuit pour suivre véhicules, conducteurs, contrôles techniques et coûts. Quatre onglets prêts à l'emploi, sans inscription."
  jsonLd={[datasetSchema, faqSchema, breadcrumb]}
>
  <Navbar client:load currentPath="/outils" />

  <section class="bg-white border-b border-zinc-100 pt-20 pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-zinc-500 mb-8 flex items-center gap-1.5" aria-label="Fil d'ariane">
        <a href="/" class="hover:text-[#0066FF]">Accueil</a><span>/</span>
        <span class="text-zinc-600">Modèle de suivi de parc automobile</span>
      </nav>
      <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-4">Outil gratuit</p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold text-zinc-900 tracking-tight leading-[1.05] max-w-3xl mb-6">
        Modèle Excel de suivi de parc automobile
      </h1>
      <p class="text-lg text-zinc-600 max-w-2xl leading-relaxed mb-8">
        Quatre onglets prêts à l'emploi — véhicules, conducteurs, dépenses, coût kilométrique — avec les échéances qui
        passent en couleur à l'approche de la date limite. Téléchargement direct, sans inscription.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 items-start">
        <a href={FILE} download
          class="inline-flex items-center justify-center gap-2 bg-[#0066FF] hover:bg-[#0052D6] text-white font-semibold text-sm px-6 py-3 rounded-lg transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger le modèle (.xlsx)
        </a>
        <span class="text-xs text-zinc-500 sm:py-3.5">Gratuit · Sans email · 10 Ko</span>
      </div>
    </div>
  </section>

  <!-- Contenu du fichier -->
  <section class="py-16 sm:py-20 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-zinc-900 mb-10 max-w-2xl leading-tight">
        Ce que contient le fichier
      </h2>
      <div class="grid md:grid-cols-2 gap-5">
        {sheets.map(s => (
          <div class="bg-white border border-zinc-200 rounded-2xl p-6">
            <span class="inline-block text-xs font-semibold uppercase tracking-wide text-[#0066FF] mb-3">Onglet</span>
            <h3 class="font-display text-lg font-semibold text-zinc-900 mb-2">{s.name}</h3>
            <p class="text-sm text-zinc-600 leading-relaxed mb-3">{s.desc}</p>
            <p class="text-xs text-zinc-500 leading-relaxed">{s.extra}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Limites -->
  <section class="py-16 sm:py-20 border-b border-zinc-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-zinc-900 mb-5 leading-tight">
        Ce qu'un tableur ne fera jamais
      </h2>
      <p class="text-zinc-600 leading-relaxed mb-6">
        Ce modèle fait correctement son travail : consigner. Il atteint ses limites dès qu'on attend de lui qu'il
        surveille à votre place.
      </p>
      <ul class="space-y-3 mb-8">
        {[
          "Il ne vous alerte pas : il faut penser à l'ouvrir, au bon moment, et lire la bonne ligne.",
          "Il ne stocke pas les justificatifs — procès-verbaux, cartes grises, permis vivent ailleurs.",
          "Il supporte mal le travail à plusieurs : les versions divergent, les formules cassent en silence.",
          "Il protège mal les données personnelles des conducteurs, qui relèvent du RGPD.",
        ].map(t => (
          <li class="flex gap-3 items-start">
            <svg class="w-5 h-5 flex-shrink-0 text-zinc-400 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span class="text-zinc-600 leading-relaxed">{t}</span>
          </li>
        ))}
      </ul>
      <p class="text-zinc-600 leading-relaxed">
        Le détail de ces limites, et le seuil à partir duquel elles coûtent cher, sont dans notre guide
        <a href="/guides/gestion-parc-automobile-excel" class="text-[#0066FF] font-medium hover:underline">gérer un parc automobile sur Excel</a>.
        Pour calculer proprement vos coûts, voir la méthode du
        <a href="/guides/cout-revient-kilometrique" class="text-[#0066FF] font-medium hover:underline">coût de revient kilométrique</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-zinc-900 mb-8">Questions fréquentes</h2>
      <div class="divide-y divide-zinc-100 border-t border-zinc-100">
        {faq.map(f => (
          <div class="py-6">
            <h3 class="font-semibold text-zinc-900 mb-2">{f.q}</h3>
            <p class="text-sm text-zinc-600 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
  <Footer />
</Layout>
