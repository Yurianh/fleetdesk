---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import CTASection from '../components/CTASection.astro'
import Footer from '../components/Footer.astro'

const APP_URL = 'https://app.fleetdesk.fr'

const driverDocs = [
  'Permis de conduire',
  'Aptitude à la conduite',
  'Casier judiciaire',
  'Formation SST / PSC1',
  'Formation TPMR',
  'Visite médecin du travail',
  'Formation éco-conduite',
]

const vehicleDocs = [
  'Carte grise',
  'Attestation d\'assurance',
  'Licence de transport',
]

const risks = [
  {
    tint: 'bg-red-50 text-red-500',
    icon: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
    title: 'Amende et immobilisation',
    desc: 'Un contrôle technique dépassé, c\'est le véhicule à l\'arrêt sur-le-champ, une amende, et un client non livré.',
  },
  {
    tint: 'bg-orange-50 text-orange-500',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    title: 'Responsabilité engagée',
    desc: 'Visite médicale périmée, formation expirée : votre conducteur roule hors la loi, et votre responsabilité est en jeu.',
  },
  {
    tint: 'bg-amber-50 text-amber-600',
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    title: 'Contrôle à l\'improviste',
    desc: 'Un contrôle routier tombe sans prévenir. Les documents doivent être à jour et présentables, tout de suite.',
  },
]

const steps = [
  { num: '01', title: 'Enregistrez vos documents', desc: 'Ajoutez permis, assurances, contrôles techniques. Photo ou PDF, en quelques secondes.' },
  { num: '02', title: 'Les échéances se calculent seules', desc: 'FleetDesk applique les durées réglementaires et pose la date d\'expiration à votre place.' },
  { num: '03', title: 'Vous êtes alerté avant', desc: 'Chaque échéance remonte au centre d\'alertes, 30 jours avant. Vous agissez avant l\'amende.' },
]

const faq = [
  {
    q: 'Quels documents FleetDesk suit-il ?',
    a: 'Côté conducteur : permis de conduire, aptitude à la conduite, casier judiciaire, formations SST/PSC1 et TPMR, visite médicale et éco-conduite. Côté véhicule : carte grise, assurance et licence de transport. Vous pouvez aussi ajouter des documents libres.',
  },
  {
    q: 'Les dates d\'expiration sont-elles calculées automatiquement ?',
    a: 'Oui. FleetDesk applique les durées de validité réglementaires (par exemple 5 ans pour l\'aptitude à la conduite, 2 ans au-delà de 62 ans) et calcule la date d\'expiration à partir de la date de validation. Vous pouvez toujours ajuster manuellement.',
  },
  {
    q: 'Comment être sûr de ne rien manquer ?',
    a: 'Chaque échéance à venir remonte automatiquement au centre d\'alertes du tableau de bord, priorisée par urgence, 30 jours avant l\'expiration. Documents, contrôles techniques et entretiens sont réunis au même endroit.',
  },
  {
    q: 'Où sont stockés ces documents sensibles ?',
    a: 'Dans un espace privé, jamais en accès public. Les fichiers ne sont servis qu\'au moyen de liens temporaires signés, à durée de validité limitée, sur des serveurs situés dans l\'Union européenne.',
  },
]
---
<Layout
  title="Conformité de flotte : contrôles techniques et documents suivis · FleetDesk"
  description="Suivez contrôles techniques, permis, visites médicales, assurances et licences de transport. Échéances calculées automatiquement, alertes avant expiration. Restez prêt pour le contrôle."
>
  <Navbar client:load currentPath="/conformite" />

  <!-- Hero -->
  <section class="bg-white border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-16">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 text-xs font-semibold px-3.5 py-1.5 rounded-full mb-7">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            Conformité réglementaire transport
          </div>
          <h1 class="font-display text-4xl sm:text-5xl font-semibold text-zinc-900 tracking-tight leading-[1.08] mb-6">
            Prêt pour le contrôle,<br /><span class="text-[#0066FF]">chaque jour</span>
          </h1>
          <p class="text-lg text-zinc-500 leading-relaxed mb-8">
            Contrôles techniques, documents conducteurs et véhicules : FleetDesk calcule chaque échéance et vous alerte avant l'expiration. Zéro document périmé, zéro amende surprise.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`${APP_URL}/login?plan=pro`}
              class="inline-flex items-center justify-center gap-2 bg-[#0066FF] hover:bg-[#0052D6] text-white font-semibold text-sm px-8 py-3.5 rounded-xl transition-all shadow-lg shadow-[#0066FF]/25">
              Essayer gratuitement
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#suivi"
              class="inline-flex items-center justify-center gap-2 border border-zinc-200 hover:border-zinc-300 text-zinc-600 hover:text-zinc-900 font-medium text-sm px-8 py-3.5 rounded-xl transition-all">
              Ce qui est suivi
            </a>
          </div>
        </div>

        <!-- Compliance mockup -->
        <div class="rounded-xl border border-zinc-200 shadow-2xl shadow-zinc-200/60 overflow-hidden bg-white">
          <div class="flex items-center gap-1.5 bg-zinc-100 border-b border-zinc-200 px-4 py-2.5">
            <div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div><div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div><div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div>
            <div class="ml-2 flex-1 max-w-xs bg-white border border-zinc-200 rounded px-3 py-0.5 text-[10px] text-zinc-400">app.fleetdesk.fr/conducteurs</div>
          </div>
          <div class="bg-zinc-50 p-5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm font-semibold text-zinc-800">Documents réglementaires</p>
              <span class="text-[11px] font-semibold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full">5/7 conformes</span>
            </div>
            <div class="h-1.5 bg-zinc-200 rounded-full overflow-hidden mb-4"><div class="h-full w-[71%] bg-amber-400 rounded-full"></div></div>
            <div class="space-y-1.5">
              {[
                { d: 'Permis de conduire',      s: 'Valide',        sc: 'text-emerald-700 bg-emerald-100', dot: 'bg-emerald-500' },
                { d: 'Visite médecin travail',  s: 'Expire 15 j',   sc: 'text-amber-700 bg-amber-100',     dot: 'bg-amber-500' },
                { d: 'Casier judiciaire',       s: 'Expiré',        sc: 'text-red-700 bg-red-100',         dot: 'bg-red-500' },
                { d: 'Formation SST / PSC1',    s: 'Valide',        sc: 'text-emerald-700 bg-emerald-100', dot: 'bg-emerald-500' },
              ].map(r => (
                <div class="flex items-center gap-3 bg-white border border-zinc-100 rounded-lg px-3 py-2">
                  <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${r.dot}`}></span>
                  <span class="text-xs text-zinc-700 flex-1">{r.d}</span>
                  <span class={`text-[10px] font-medium px-2 py-0.5 rounded-full ${r.sc}`}>{r.s}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Risk -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-12 max-w-2xl">
        <p class="text-sm font-semibold text-red-500 tracking-wide mb-3">Ce que coûte un oubli</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
          La non-conformité coûte plus cher qu'un logiciel
        </h2>
        <p class="text-lg text-zinc-500 leading-relaxed">
          Un document périmé ne prévient pas. Il se rappelle à vous au pire moment : un contrôle, une amende, un véhicule cloué au sol.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {risks.map(r => (
          <div class="bg-white border border-zinc-200 rounded-2xl p-6">
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-4 ${r.tint}`}>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
            </div>
            <h3 class="text-base font-semibold text-zinc-900 mb-1.5">{r.title}</h3>
            <p class="text-sm text-zinc-500 leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What is tracked -->
  <section id="suivi" class="scroll-mt-16 py-24 bg-white border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-14 max-w-2xl">
        <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Ce que FleetDesk suit</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
          Tous vos documents, une seule échéance à ne pas rater
        </h2>
        <p class="text-lg text-zinc-500 leading-relaxed">
          Conducteurs et véhicules réunis. Chaque pièce a sa date, chaque date a son alerte.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <!-- Driver documents -->
        <div class="md:col-span-2 bg-zinc-50 border border-zinc-100 rounded-2xl p-6">
          <div class="flex items-center gap-2.5 mb-5">
            <div class="w-9 h-9 rounded-lg bg-[#E5EEFF] flex items-center justify-center">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 9h3"/><path d="M15 13h3"/><path d="M7 15.5c.7-1.2 3.3-1.2 4 0"/></svg>
            </div>
            <h3 class="text-lg font-semibold text-zinc-900">7 documents conducteur</h3>
          </div>
          <div class="grid sm:grid-cols-2 gap-2">
            {driverDocs.map(d => (
              <div class="flex items-center gap-2 bg-white border border-zinc-100 rounded-lg px-3 py-2.5">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-sm text-zinc-700">{d}</span>
              </div>
            ))}
          </div>
          <p class="text-xs text-zinc-400 mt-4">Durées réglementaires appliquées automatiquement, y compris la règle des 2 ans au-delà de 62 ans pour l'aptitude à la conduite.</p>
        </div>

        <!-- Vehicle documents + CT -->
        <div class="flex flex-col gap-5">
          <div class="bg-zinc-50 border border-zinc-100 rounded-2xl p-6">
            <div class="flex items-center gap-2.5 mb-4">
              <div class="w-9 h-9 rounded-lg bg-[#E5EEFF] flex items-center justify-center">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="2"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-zinc-900">Documents véhicule</h3>
            </div>
            <ul class="space-y-2">
              {vehicleDocs.map(d => (
                <li class="flex items-center gap-2 text-sm text-zinc-700">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                  {d}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-6">
            <div class="flex items-center gap-2.5 mb-2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              <h3 class="text-lg font-semibold text-zinc-900">Contrôles techniques</h3>
            </div>
            <p class="text-sm text-zinc-600 leading-relaxed">Dates, résultats et prochaines échéances suivis par véhicule, avec rappel avant expiration.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-20">
        <div class="lg:sticky lg:top-24 self-start">
          <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">3 étapes</p>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
            Vous enregistrez, FleetDesk surveille
          </h2>
          <p class="text-lg text-zinc-500 leading-relaxed">
            Aucune date à retenir, aucun rappel à programmer. Le calcul et l'alerte se font pour vous.
          </p>
        </div>
        <div class="relative">
          <div class="absolute left-[21px] top-3 bottom-3 w-px bg-zinc-200"></div>
          {steps.map(s => (
            <div class="relative flex gap-6 pb-10 last:pb-0">
              <div class="relative z-10 w-11 h-11 rounded-xl bg-[#E5EEFF] text-[#0066FF] font-bold flex items-center justify-center flex-shrink-0 ring-4 ring-zinc-50">{s.num}</div>
              <div class="pt-1.5">
                <h3 class="text-lg font-semibold text-zinc-900 mb-1.5">{s.title}</h3>
                <p class="text-zinc-500 leading-relaxed">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Security -->
  <section class="py-24 bg-white border-b border-zinc-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <div class="w-12 h-12 rounded-2xl bg-[#E5EEFF] flex items-center justify-center mx-auto mb-5">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4">Des documents sensibles, tenus au privé</h2>
      <p class="text-lg text-zinc-500 leading-relaxed max-w-2xl mx-auto">
        Permis, casier, visites médicales : ces pièces ne doivent jamais fuir. Elles sont stockées dans un espace privé, jamais accessibles publiquement, servies uniquement via des liens temporaires signés, sur des serveurs situés dans l'Union européenne.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Questions fréquentes</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900">La conformité, sans zone d'ombre</h2>
      </div>
      <div class="divide-y divide-zinc-200">
        {faq.map(item => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
              <span class="font-medium text-zinc-900">{item.q}</span>
              <svg class="w-4 h-4 flex-shrink-0 text-zinc-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="text-sm text-zinc-500 leading-relaxed mt-3 pr-8">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
  <Footer />
</Layout>
