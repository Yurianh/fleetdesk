---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import HeroSection from '../components/HeroSection.jsx'
import CTASection from '../components/CTASection.astro'
import Footer from '../components/Footer.astro'

const APP_URL = 'https://app.fleetdesk.fr'

const pains = [
  {
    icon: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
    iconCls: 'bg-red-50 text-red-500',
    title: 'CT manqué, véhicule à l\'arrêt',
    desc: 'Un oubli de date = immobilisation immédiate, amende, client non livré. FleetDesk alerte 30 jours avant l\'échéance.',
  },
  {
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>',
    iconCls: 'bg-orange-50 text-orange-500',
    title: 'Conducteur hors conformité',
    desc: 'Visite médicale périmée, formation SST expirée : votre chauffeur roule illégalement, sans que personne le sache.',
  },
  {
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
    iconCls: 'bg-amber-50 text-amber-600',
    title: 'La panne qu\'on aurait pu éviter',
    desc: 'La vidange oubliée qui finit en moteur HS. Sans suivi kilométrique, les maintenances préventives ne se font jamais.',
  },
  {
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>',
    iconCls: 'bg-zinc-100 text-zinc-500',
    title: 'Excel n\'est pas un outil de flotte',
    desc: 'Formules cassées, onglets divergents, données perdues. Dès 5 véhicules, un tableur devient un problème.',
  },
]

const steps = [
  {
    num: '01',
    title: 'Ajoutez votre flotte',
    desc: 'Immatriculations, kilométrages, conducteurs : tout est en place en moins de 5 minutes. Aucune formation requise.',
    color: 'text-[#0066FF]',
    numBg: 'bg-[#E5EEFF] text-[#0066FF]',
    border: 'border-[#C8DBFF]',
  },
  {
    num: '02',
    title: 'Configurez vos alertes',
    desc: 'Contrôles techniques, documents conducteurs, intervalles de maintenance : FleetDesk surveille à votre place, 24h/24.',
    color: 'text-[#0066FF]',
    numBg: 'bg-[#E5EEFF] text-[#0066FF]',
    border: 'border-[#C8DBFF]',
  },
  {
    num: '03',
    title: 'Pilotez sans y penser',
    desc: 'Tableau de bord centralisé, alertes proactives, zéro oubli. Votre flotte tourne. Vous restez conformes.',
    color: 'text-[#0066FF]',
    numBg: 'bg-[#E5EEFF] text-[#0066FF]',
    border: 'border-[#C8DBFF]',
  },
]

const testimonials = [
  {
    name: 'Marc Lefebvre',
    role: 'Gérant · Lefebvre Express',
    sector: 'Livraison · 8 véhicules',
    initials: 'ML',
    avatarBg: 'bg-[#E5EEFF] text-[#0066FF]',
    quote: 'Le premier mois, FleetDesk m\'a rappelé 3 contrôles techniques que j\'avais complètement oubliés. Trois immobilisations évitées dès le départ.',
  },
  {
    name: 'Sophie Renard',
    role: 'Responsable flotte · BTP Renard',
    sector: 'BTP · 12 véhicules',
    initials: 'SR',
    avatarBg: 'bg-[#E0F5FE] text-[#0EA5E9]',
    quote: 'Le suivi des documents conducteurs était un cauchemar sur Excel. Maintenant j\'ai une alerte dès qu\'une visite médicale approche. Fini les mauvaises surprises.',
  },
  {
    name: 'Karim Aïssa',
    role: 'Gérant · AK Plomberie',
    sector: 'Artisan · 5 véhicules',
    initials: 'KA',
    avatarBg: 'bg-emerald-100 text-emerald-600',
    quote: 'Je cherchais quelque chose de simple, pas un ERP à configurer pendant 3 semaines. FleetDesk s\'apprend en une heure. Mes maintenances sont planifiées 3 mois à l\'avance.',
  },
]

const faq = [
  {
    q: 'Est-ce que je peux importer ma flotte depuis Excel ?',
    a: 'Oui. Vous ajoutez vos véhicules et conducteurs en quelques minutes, sans import complexe. La plupart des gérants sont opérationnels en moins de 5 minutes, sans formation.',
  },
  {
    q: 'L\'essai Pro est-il vraiment sans carte bancaire ?',
    a: '14 jours d\'accès complet au plan Pro, sans rien saisir. Vous choisissez de continuer, ou pas. Aucun prélèvement sans votre accord.',
  },
  {
    q: 'Combien de véhicules puis-je suivre ?',
    a: 'De 2 à 50 véhicules selon la formule : jusqu\'à 5 sur Starter, 25 sur Pro, illimité sur Enterprise. Vous êtes prévenu avant d\'atteindre la limite, jamais coupé sans avertissement.',
  },
  {
    q: 'Mes chauffeurs peuvent-ils saisir eux-mêmes ?',
    a: 'Oui. Chaque chauffeur reçoit un accès dédié, limité à son véhicule. Il enregistre kilométrage, pleins et lavages depuis son téléphone, avec photo de facture. Vous récupérez la donnée sans la ressaisir.',
  },
  {
    q: 'Puis-je stocker les permis, assurances et cartes grises ?',
    a: 'Oui. FleetDesk conserve les documents de vos conducteurs et véhicules, calcule leurs échéances et vous alerte avant expiration. Les fichiers sont stockés en privé, jamais en accès public.',
  },
  {
    q: 'Où sont hébergées mes données ?',
    a: 'En Union européenne. Vos données sont conformes au RGPD et exportables à tout moment. Elles vous appartiennent.',
  },
  {
    q: 'Puis-je résilier facilement ?',
    a: 'Résiliation en un clic depuis vos paramètres, sans engagement et sans rétention de vos données.',
  },
]

const teaserPlans = [
  { name: 'Starter', price: '9',  note: 'Jusqu\'à 5 véhicules',      highlighted: false, href: `${APP_URL}/login?plan=starter`, cta: 'Choisir' },
  { name: 'Pro',     price: '29', note: '14 jours d\'essai gratuit', highlighted: true,  href: `${APP_URL}/login?plan=pro`,     cta: 'Essayer' },
  { name: 'Enterprise', price: '79', note: 'Flottes illimitées',     highlighted: false, href: '/pricing',                      cta: 'Voir' },
]
---
<Layout
  title="FleetDesk · Gestion de flotte et conformité pour PME de transport"
  description="Pilotez votre flotte, restez conforme, laissez vos chauffeurs saisir depuis le terrain. Alertes contrôle technique et documents, suivi kilométrage et pleins, prévisions d'entretien."
>
  <Navbar client:load currentPath="/" />

  <HeroSection client:load />

  <!-- 3 pillars -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-14 max-w-2xl">
        <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Une flotte, trois métiers</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
          Piloter, rester conforme, faire saisir le terrain
        </h2>
        <p class="text-lg text-zinc-500 leading-relaxed">
          FleetDesk réunit les trois choses qui vous coûtent du temps et de l'argent aujourd'hui, dans un seul outil.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {[
          {
            tint: 'bg-[#E5EEFF]', stroke: '#0066FF',
            icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
            title: 'Piloter votre flotte',
            desc: 'Véhicules, conducteurs, coûts et kilométrages dans un seul tableau de bord. Vous décidez sur des données, plus sur des souvenirs.',
            points: ['Fiches véhicules et historiques', 'Affectations et suivi kilométrique', 'Coûts et utilisation par véhicule'],
          },
          {
            tint: 'bg-emerald-50', stroke: '#059669',
            icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
            title: 'Rester conforme',
            desc: 'Contrôles techniques, documents conducteurs et véhicules suivis avec leurs échéances. Alerté avant l\'amende, prêt pour le contrôle.',
            points: ['Contrôles techniques et alertes', 'Permis, visite médicale, formations', 'Carte grise, assurance, licence de transport'],
          },
          {
            tint: 'bg-[#E0F5FE]', stroke: '#0EA5E9',
            icon: '<path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="2"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>',
            title: 'Faire saisir le terrain',
            desc: 'Vos chauffeurs enregistrent kilométrage et pleins depuis leur téléphone, facture à l\'appui. Vous récupérez la donnée sans la ressaisir.',
            points: ['Accès chauffeur restreint à son véhicule', 'Kilométrage et lavages en un geste', 'Preuve de facture et carte carburant'],
          },
        ].map(p => (
          <div class="bg-white border border-zinc-200 rounded-2xl p-6 flex flex-col">
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-5 ${p.tint}`}>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke={p.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </div>
            <h3 class="text-lg font-semibold text-zinc-900 mb-2">{p.title}</h3>
            <p class="text-sm text-zinc-500 leading-relaxed mb-5">{p.desc}</p>
            <ul class="space-y-2 mt-auto">
              {p.points.map(pt => (
                <li class="flex items-start gap-2 text-sm text-zinc-600">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Problem section -->
  <section class="py-24 bg-white border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-20">
        <div class="lg:sticky lg:top-24 self-start">
          <p class="text-sm font-semibold text-red-500 tracking-wide mb-3">Le vrai coût de l'oubli</p>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
            Ce que coûte vraiment une flotte mal suivie
          </h2>
          <p class="text-lg text-zinc-500 leading-relaxed">
            Un CT manqué, une visite médicale oubliée, une vidange trop tardive : les petits oublis finissent toujours par coûter cher.
          </p>
        </div>
        <div class="border-t border-zinc-100">
          {pains.map(p => (
            <div class="flex items-start gap-5 py-6 border-b border-zinc-100">
              <div class={`w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 ${p.iconCls}`}>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-900 mb-1">{p.title}</h3>
                <p class="text-sm text-zinc-500 leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="mb-12 max-w-2xl">
        <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Ni tableur, ni usine à gaz</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4">
          Le juste milieu que vous cherchiez
        </h2>
        <p class="text-lg text-zinc-500">
          Le tableur ne suit rien tout seul. L'ERP demande des semaines et un budget. FleetDesk fait le travail, sans la complexité.
        </p>
      </div>

      <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[640px] border-separate border-spacing-0">
          <thead>
            <tr>
              <th class="text-left align-bottom pb-4 pr-4 w-[34%]"></th>
              <th class="text-center align-bottom pb-4 px-4 text-sm font-medium text-zinc-400">Tableur Excel</th>
              <th class="text-center align-bottom pb-4 px-4 text-sm font-medium text-zinc-400">Logiciel ERP</th>
              <th class="text-center align-bottom pb-3 px-4">
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066FF] bg-[#E5EEFF] px-3 py-1 rounded-full">FleetDesk</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {[
              { label: 'Mise en route',                  excel: 'Manuelle, formules fragiles', erp: 'Plusieurs semaines',     fd: '5 minutes' },
              { label: 'Alertes CT & documents',         excel: false,                          erp: 'Souvent en option',      fd: 'Automatiques, 30j avant' },
              { label: 'Spécificités françaises (CT, carte grise)', excel: false,                erp: 'Rarement',               fd: true },
              { label: 'Courbe d\'apprentissage',        excel: 'Élevée à grande échelle',      erp: 'Élevée',                 fd: 'Aucune formation requise' },
              { label: 'Prix',                           excel: 'Gratuit, mais coûteux en oublis', erp: 'Élevé, sur devis',    fd: 'Dès 9 €/mois' },
              { label: 'Support',                        excel: false,                          erp: 'Variable',               fd: 'Email & prioritaire' },
            ].map((row, i, arr) => (
              <tr>
                <td class={`py-4 pr-4 text-sm font-medium text-zinc-700 ${i < arr.length - 1 ? 'border-b border-zinc-100' : ''}`}>{row.label}</td>
                {[row.excel, row.erp].map(cell => (
                  <td class={`py-4 px-4 text-center text-sm text-zinc-400 ${i < arr.length - 1 ? 'border-b border-zinc-100' : ''}`}>
                    {cell === false
                      ? <svg class="w-4 h-4 mx-auto text-zinc-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      : <span>{cell}</span>}
                  </td>
                ))}
                <td class={`py-4 px-4 text-center text-sm font-medium text-zinc-800 bg-[#0066FF]/[0.04] ${i === 0 ? 'rounded-t-xl' : ''} ${i === arr.length - 1 ? 'rounded-b-xl' : ''}`}>
                  {row.fd === true
                    ? <svg class="w-4 h-4 mx-auto text-[#0066FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    : <span>{row.fd}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="scroll-mt-16 py-24 bg-white border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-20">
        <div class="lg:sticky lg:top-24 self-start">
          <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">3 étapes</p>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
            Opérationnel en 5 minutes
          </h2>
          <p class="text-lg text-zinc-500 leading-relaxed">
            Aucune intégration, aucune formation. Vous êtes prêt avant la fin de votre café.
          </p>
        </div>

        <!-- Vertical timeline -->
        <div class="relative">
          <div class="absolute left-[21px] top-3 bottom-3 w-px bg-zinc-200" />
          {steps.map(s => (
            <div class="relative flex gap-6 pb-10 last:pb-0">
              <div class="relative z-10 w-11 h-11 rounded-xl bg-[#E5EEFF] text-[#0066FF] font-bold flex items-center justify-center flex-shrink-0 ring-4 ring-white">
                {s.num}
              </div>
              <div class="pt-1.5">
                <h3 class="text-lg font-semibold text-zinc-900 mb-1.5">{s.title}</h3>
                <p class="text-zinc-500 leading-relaxed">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-14 text-center">
        <a href={`${APP_URL}/login?plan=pro`}
          class="inline-flex items-center gap-2 bg-[#0066FF] hover:bg-[#0052D6] text-white font-semibold text-sm px-6 py-3 rounded-lg transition-colors">
          Essayer gratuitement
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <p class="mt-3 text-xs text-zinc-400">14 jours d'essai sur Pro · sans carte bancaire</p>
      </div>
    </div>
  </section>

  <!-- Features: alternating product rows -->
  <section class="py-24 bg-zinc-50 border-b border-zinc-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-16 max-w-2xl">
        <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Ce qui fait la différence</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold text-zinc-900 mb-4 leading-tight">
          Moins d'oublis. Moins de pannes. Plus de maîtrise.
        </h2>
        <p class="text-lg text-zinc-500 leading-relaxed">
          Des fiches véhicules aux prévisions de maintenance : sans tableur, sans formation, sans prise de tête.
        </p>
      </div>

      <div class="space-y-16 lg:space-y-24">

        <!-- Row 1: Véhicules (text left, mockup right) -->
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class="max-w-md">
            <div class="w-11 h-11 rounded-xl bg-[#E5EEFF] flex items-center justify-center mb-5">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#0066FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/><rect x="9" y="11" width="14" height="10" rx="2"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/></svg>
            </div>
            <h3 class="text-2xl font-semibold text-zinc-900 mb-3">Vos véhicules, d'un coup d'œil</h3>
            <p class="text-lg text-zinc-500 leading-relaxed">Statut, kilométrage, historique de chaque véhicule au même endroit. Vous savez, sans chercher.</p>
          </div>
          <div class="rounded-xl border border-zinc-200 shadow-xl shadow-zinc-200/50 overflow-hidden bg-white">
            <div class="flex items-center gap-1.5 bg-zinc-100 border-b border-zinc-200 px-4 py-2.5">
              <div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div><div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div><div class="w-2.5 h-2.5 rounded-full bg-zinc-300"></div>
              <div class="ml-2 flex-1 max-w-xs bg-white border border-zinc-200 rounded px-3 py-0.5 text-[10px] text-zinc-400">app.fleetdesk.fr/vehicules</div>
            </div>
            <div class="bg-zinc-50 p-5">
              <div class="flex items-center px-3 py-1 mb-2 border-b border-zinc-200">
                <span class="text-[10px] font-medium text-zinc-400 uppercase tracking-wide flex-1">Immatriculation</span>
                <span class="text-[10px] font-medium text-zinc-400 uppercase tracking-wide w-24 text-center">Statut</span>
                <span class="text-[10px] font-medium text-zinc-400 uppercase tracking-wide w-24 text-right">Kilométrage</span>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center bg-white border border-zinc-100 rounded-lg px-3 py-2.5"><span class="text-xs text-zinc-700 flex-1">AB-123-CD</span><span class="text-[10px] bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full w-24 text-center">Actif</span><span class="text-xs text-zinc-400 w-24 text-right">45 200 km</span></div>
                <div class="flex items-center bg-white border border-zinc-100 rounded-lg px-3 py-2.5"><span class="text-xs text-zinc-700 flex-1">EF-456-GH</span><span class="text-[10px] bg-amber-50 text-amber-600 px-2 py-0.5 rounded-full w-24 text-center">Révision</span><span class="text-xs text-zinc-400 w-24 text-right">31 800 km</span></div>
                <div class="flex items-center bg-white border border-zinc-100 rounded-lg px-3 py-2.5"><span class="text-xs text-zinc-700 flex-1">IJ-789-KL</span><span class="text-[10px] bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full w-24 text-center">Actif</span><span class="text-xs text-zinc-400 w-24 text-right">78 400 km</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Conducteurs (mockup left, text right) -->
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class="lg:order-2 max-w-md">
            <div class="w-11 h-11 rounded-xl bg-[#E0F5FE] flex items-center justify-center mb-5">
