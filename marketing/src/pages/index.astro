<script>
  // Planche II : la vidéo joue tant qu'elle est visible ; image fixe sous « moins d'animations ».
  const film = document.getElementById('home-film') as HTMLVideoElement | null
  if (film) {
    film.muted = true
    // Mobile : la version portrait a sa propre image d'attente.
    if (window.matchMedia('(max-width: 639px)').matches) film.poster = '/hero/fleetdesk-hero-portrait-poster.jpg'
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) film.play().catch(() => {})
        else film.pause()
      }, { threshold: 0.25 }).observe(film)
    }
  }

  // Tarifs : annuel par défaut, le visiteur bascule lui-même.
  const billingBtns = document.querySelectorAll<HTMLButtonElement>('.billing-btn')
  billingBtns.forEach(btn => btn.addEventListener('click', () => {
    const annual = btn.dataset.billing === 'annual'
    billingBtns.forEach(b => {
      const on = b === btn
      b.setAttribute('aria-pressed', String(on))
      b.classList.toggle('bg-plate-ink', on); b.classList.toggle('text-white', on)
      b.classList.toggle('font-semibold', on); b.classList.toggle('text-[#24365C]', !on)
    })
    document.querySelectorAll<HTMLElement>('.price-amount').forEach(el => { el.textContent = (annual ? el.dataset.annual : el.dataset.monthly) ?? '' })
    document.querySelectorAll<HTMLElement>('.price-annual').forEach(el => el.classList.toggle('hidden', !annual))
  }))
</script>
