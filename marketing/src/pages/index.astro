---
// Accueil, direction « Planche » : encre bleue sur papier, filets doubles,
// gravures légendées comme des planches d'atlas (canvas « FleetDesk gravure »,
// variante A). Les illustrations viennent de scripts/footer-landscape.mjs.
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import FeatureVideo from '../components/FeatureVideo.astro'
import Diagnostic from '../components/Diagnostic.jsx'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'

const pains = [
  {
    icon: 'calendarClock',
    title: 'Contrôle technique manqué, véhicule à l\'arrêt',
    desc: 'Un oubli de date, et c\'est l\'immobilisation, l\'amende, le client non livré. FleetDesk alerte 30 jours avant l\'échéance.',
  },
  {
    icon: 'idCard',
    title: 'Conducteur hors conformité',
    desc: 'Visite médicale périmée, formation SST expirée : votre chauffeur roule illégalement, sans que personne le sache.',
  },
  {
    icon: 'wrench',
    title: 'La panne qu\'on aurait pu éviter',
    desc: 'La vidange oubliée qui finit en moteur HS. Sans suivi kilométrique, l\'entretien préventif ne se fait jamais.',
  },
  {
    icon: 'spreadsheet',
    title: 'Excel n\'est pas un outil de flotte',
    desc: 'Formules cassées, onglets divergents, données perdues. Dès 5 véhicules, le tableur devient un problème.',
  },
]

const pillars = [
  {
    img: '/engravings/depot.svg',
    alt: 'Gravure : trois berlines FleetDesk alignées devant le dépôt',
    title: 'Piloter votre flotte',
    desc: 'Véhicules, conducteurs, coûts et kilométrages dans un seul tableau de bord. Vous décidez sur des données, plus sur des souvenirs.',
    points: ['Fiches véhicules et historiques', 'Affectations et suivi kilométrique', 'Coûts et utilisation par véhicule'],
  },
  {
    img: '/engravings/controle-technique.svg',
    alt: 'Gravure : une berline sur le pont d\'un centre de contrôle technique',
    title: 'Rester conforme',
    desc: 'Contrôles techniques, documents conducteurs et véhicules suivis avec leurs échéances. Alerté avant l\'amende, prêt pour le contrôle.',
    points: ['Contrôles techniques et alertes', 'Permis, visite médicale, formations', 'Récapitulatif des échéances par email'],
  },
  {
    img: '/engravings/station-service.svg',
    alt: 'Gravure : à la pompe, le chauffeur saisit son plein sur son téléphone',
    title: 'Faire saisir le terrain',
    desc: 'Vos chauffeurs enregistrent kilométrage et pleins depuis leur téléphone, facture à l\'appui. Vous récupérez la donnée sans la ressaisir.',
    points: ['Accès chauffeur restreint à son véhicule', 'Kilométrage et lavages en un geste', 'Preuve de facture et carte carburant'],
  },
]

// Ce qui fait la différence : chaque argument montré par sa vidéo (motion/).
const features = [
  {
    video: 'fiche', icon: 'truck',
    title: 'Vos véhicules, d\'un coup d\'œil',
    desc: 'Statut, kilométrage, historique de chaque véhicule au même endroit. Vous savez, sans chercher.',
    label: 'Démonstration : un clic sur le Peugeot Boxer ouvre sa fiche, avec son conducteur, son kilométrage, son contrôle technique et sa prochaine vidange.',
  },
  {
    video: 'documents', icon: 'idCard',
    title: 'Zéro document expiré',
    desc: 'Permis, visite médicale, formations côté conducteur ; carte grise, assurance, licence de transport côté véhicule. FleetDesk calcule les échéances et vous alerte avant qu\'un conducteur ou un véhicule soit hors la loi.',
    label: 'Démonstration : la visite médicale de Sophie Renard expire dans 15 jours ; le nouveau certificat est déposé sur sa fiche et l\'échéance est recalculée jusqu\'en 2031.',
  },
  {
    video: 'entretien', icon: 'wrench',
    title: 'Anticipez les pannes',
    desc: 'Par intervalle kilométrique ou temporel, FleetDesk prévoit l\'entretien et vous prévient avant la casse.',
    label: 'Démonstration : trois utilitaires et leur prochaine vidange, calculée sur le kilométrage réel ; l\'alerte passe à l\'ambre 5 000 km avant, puis l\'entretien est enregistré.',
  },
  {
    video: 'couts', icon: 'chart',
    title: 'Comprenez vos coûts réels',
    desc: 'Coûts, kilométrages, tendances : pas dans un tableur, dans un vrai tableau de bord.',
    label: 'Démonstration : le rapport du mois se construit, avec le total des dépenses, la répartition entretien, carburant et lavages, et les véhicules les plus coûteux.',
  },
  {
    video: 'saisie', icon: 'smartphone',
    title: 'Vos chauffeurs saisissent au volant',
    desc: 'Un accès dédié, limité à leur véhicule. Ils notent le kilométrage et le plein en un geste, photo de facture à l\'appui. Vous récupérez la donnée sans la ressaisir.',
    label: 'Démonstration : une conductrice saisit son kilométrage, le montant du plein et deux photos sur son téléphone ; la saisie apparaît aussitôt dans l\'activité du bureau.',
  },
]
const roman = ['III', 'IV', 'V', 'VI', 'VII']

const comparison = [
  { label: 'Mise en route',                                  excel: 'Manuelle, formules fragiles',     erp: 'Plusieurs semaines', fd: '5 minutes' },
  { label: 'Alertes contrôle technique et documents',        excel: false,                             erp: 'Souvent en option',  fd: 'Automatiques, 30 jours avant' },
  { label: 'Spécificités françaises (contrôle technique, carte grise)', excel: false,                  erp: 'Rarement',           fd: true },
  { label: 'Courbe d\'apprentissage',                        excel: 'Élevée à grande échelle',         erp: 'Élevée',             fd: 'Aucune formation requise' },
  { label: 'Prix',                                           excel: 'Gratuit, mais coûteux en oublis', erp: 'Élevé, sur devis',   fd: 'Dès 9 €/mois' },
  { label: 'Support',                                        excel: false,                             erp: 'Variable',           fd: 'Email et prioritaire' },
]

const faq = [
  {
    q: 'Est-ce que je peux importer ma flotte depuis Excel ?',
    a: 'Oui. Vous ajoutez vos véhicules et conducteurs en quelques minutes, sans import complexe. La plupart des gérants sont opérationnels en moins de 5 minutes, sans formation.',
  },
  {
    q: 'L\'essai est-il vraiment sans carte bancaire ?',
    a: 'Oui. 7 jours d\'accès complet à la formule de votre choix, sans carte bancaire. 48 h avant la fin, on vous prévient par e-mail. Vous choisissez de continuer, ou pas : rien n\'est prélevé sans votre accord, et arrêter ne coûte rien. Sans abonnement à la fin de l\'essai, votre compte passe en lecture seule — vos données restent consultables.',
  },
  {
    q: 'Combien de véhicules puis-je suivre ?',
    a: 'De 2 à 50 véhicules selon la formule : jusqu\'à 5 sur Starter, 25 sur Pro, illimité sur Enterprise. Vous êtes prévenu avant d\'atteindre la limite, jamais coupé sans avertissement.',
  },
  {
    q: 'Mes chauffeurs peuvent-ils saisir eux-mêmes ?',
    a: 'Oui. Chaque chauffeur reçoit un accès dédié, limité à son véhicule. Il enregistre kilométrage, pleins et lavages depuis son téléphone, avec photo de facture. Vous récupérez la donnée sans la ressaisir.',
  },
  {
    q: 'Puis-je stocker les permis, assurances et cartes grises ?',
    a: 'Oui. FleetDesk conserve les documents de vos conducteurs et véhicules, calcule leurs échéances et vous alerte avant expiration. Les fichiers sont stockés en privé, jamais en accès public.',
  },
  {
    q: 'Où sont hébergées mes données ?',
    a: 'En Union européenne. Vos données sont conformes au RGPD et exportables à tout moment. Elles vous appartiennent.',
  },
  {
    q: 'Puis-je résilier facilement ?',
    a: 'Résiliation en un clic depuis vos paramètres, sans engagement et sans rétention de vos données.',
  },
]

// Annuel affiché d'abord ; le visiteur bascule lui-même sur le mensuel.
const plans = [
  { name: 'Starter',    price: '9',  annual: '70',  annualMonthly: '6',  note: 'jusqu\'à 5 véhicules',  highlighted: false },
  { name: 'Pro',        price: '29', annual: '220', annualMonthly: '18', note: 'jusqu\'à 25 véhicules', highlighted: true },
  { name: 'Enterprise', price: '79', annual: '600', annualMonthly: '50', note: 'véhicules illimités',   highlighted: false },
]

const resources = [
  {
    t: 'Logiciel de gestion de parc automobile : le guide d\'achat',
    d: 'Les six fonctions qui séparent un outil utile d\'une base de données de plus, et l\'approche adaptée à chaque taille de parc.',
    h: '/logiciel-gestion-de-flotte',
    cta: 'Lire le guide d\'achat',
  },
  {
    t: 'Votre secteur, vos échéances',
    d: 'Transport routier, BTP, VTC et taxi, véhicules de société : ce que FleetDesk suit pour chaque métier.',
    h: '/secteurs',
    cta: 'Voir les secteurs',
  },
  {
    t: 'Modèle Excel de suivi de parc',
    d: 'Quatre onglets prêts à l\'emploi pour structurer véhicules, conducteurs et échéances. Gratuit, sans inscription.',
    h: '/outils/modele-suivi-parc-automobile-excel',
    cta: 'Télécharger le modèle',
  },
]

// Structured data for the homepage: organisation, product and the FAQ.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FleetDesk',
  url: 'https://fleetdesk.fr',
  logo: 'https://fleetdesk.fr/logo-mark.png',
  description: 'Logiciel de gestion de flotte et de conformité pour les PME de transport.',
}
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FleetDesk',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: plans.map(p => ({ '@type': 'Offer', name: p.name, price: p.price, priceCurrency: 'EUR' })),
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}

// Cadre de planche : filet extérieur, marge blanche, filet intérieur.
const plate = 'border border-plate-ink bg-white p-1.5 sm:p-2'
const plateInner = 'border border-plate-ink'
const caption = 'flex flex-wrap justify-between gap-x-6 gap-y-1 mt-2.5 text-[12.5px] tracking-[0.04em] text-plate-muted'
const h2 = 'text-[32px] sm:text-[42px] leading-[1.1] font-bold tracking-[-0.02em] text-plate-text'
const lead = 'text-[17.5px] leading-relaxed text-plate-body'
---
<Layout
  title="Logiciel de gestion de flotte et de conformité pour PME"
  description="Pilotez votre flotte et restez conforme : alertes contrôle technique et documents, suivi du kilométrage et des pleins, prévisions d'entretien. Dès 9 €/mois."
  jsonLd={[orgSchema, softwareSchema, faqSchema]}
>
  <div class="bg-plate-paper text-plate-text">
  <Navbar client:load currentPath="/" />

  <!-- Hero : texte et planche gravée -->
  <section data-own-motion class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 lg:pt-20 pb-12 grid lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-14 items-center">
    <div class="flex flex-col gap-6 min-w-0">
      <span style="animation-delay: 80ms" class="enter inline-flex self-start items-center gap-2 border border-plate-ink text-plate-ink text-[12.5px] font-semibold tracking-[0.06em] uppercase px-3 py-1.5 rounded-full">
        <Icon name="truck" size={14} />
        Pour les flottes de 2 à 50 véhicules
      </span>

      <h1 class="text-[40px] sm:text-[52px] lg:text-[58px] leading-[1.04] font-bold tracking-[-0.03em]" style="text-wrap: balance">
        <span style="animation-delay: 180ms" class="enter block">Le logiciel de gestion de flotte</span>
        <span style="animation-delay: 320ms" class="enter block text-plate-ink">qui ne laisse passer aucune échéance.</span>
      </h1>

      <p style="animation-delay: 560ms" class={`enter ${lead} sm:text-[19px] max-w-xl`}>
        Contrôles techniques, permis et documents conducteurs, entretiens : FleetDesk suit chaque véhicule de votre
        entreprise et vous alerte 30 jours avant. Vos chauffeurs saisissent kilométrage et pleins depuis leur téléphone.
      </p>

      <div style="animation-delay: 700ms" class="enter flex flex-col sm:flex-row gap-3">
        <a href="/pricing" class="cta-brand inline-flex items-center justify-center gap-2.5 bg-plate-ink text-white font-semibold px-6 py-4 rounded-xl">
          Essayer 7 jours gratuitement
          <Icon name="arrowRight" size={16} />
        </a>
        <a href="#comment" class="inline-flex items-center justify-center bg-white text-plate-text font-medium px-6 py-4 rounded-xl border border-plate-rule hover:border-plate-ink transition-colors">
          Comment ça marche
        </a>
      </div>

      <ul style="animation-delay: 840ms" class="enter flex flex-wrap gap-x-5 gap-y-2 text-[14.5px] text-plate-body">
        {['Sans carte bancaire', 'Prêt en 5 minutes', 'Sans engagement'].map(item => (
          <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-plate-ink" />{item}</li>
        ))}
      </ul>
    </div>

    <figure style="animation-delay: 420ms" class="enter m-0 min-w-0">
      <div class={plate}>
        <div class={`${plateInner} relative overflow-hidden aspect-[7/5] bg-plate-ink`}>
          <img src="/footer-landscape.svg" alt="Gravure : une berline FleetDesk traverse une rue d'immeubles haussmanniens"
            class="absolute bottom-0 max-w-none w-[250%] left-[-112%]" width="1600" height="520" fetchpriority="high" />
        </div>
      </div>
      <figcaption class={caption}>
        <span>PLANCHE I · LA TOURNÉE DU MATIN</span>
        <span>Kangoo AB-123-CD · contrôle technique dans 12 jours</span>
      </figcaption>
    </figure>
  </section>

  <!-- Bandeau de réassurance -->
  <div class="border-y border-plate-ink bg-white">
    <ul class="max-w-6xl mx-auto px-4 sm:px-6 py-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-[14.5px] text-[#24365C]">
      {[
        ['calendarClock', 'Alerte 30 jours avant chaque échéance'],
        ['idCard',        'Documents conducteurs suivis'],
        ['shield',        'Données hébergées dans l\'UE'],
        ['smartphone',    'Saisie chauffeur sur téléphone'],
      ].map(([icon, text]) => (
        <li class="flex items-center gap-2.5"><Icon name={icon as any} size={20} class="text-plate-ink flex-shrink-0" />{text}</li>
      ))}
    </ul>
  </div>

  <!-- Ce que coûte une flotte mal suivie -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-20 sm:pt-24 pb-10">
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-12 items-end mb-10">
      <h2 class={h2} style="text-wrap: balance">Ce que coûte vraiment une flotte mal suivie</h2>
      <p class={lead}>Un contrôle technique manqué, une visite médicale oubliée, une vidange trop tardive : les petits oublis finissent toujours par coûter cher.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 border-t-2 border-plate-ink">
      {pains.map(p => (
        <div class="py-7 border-b border-plate-rule flex flex-col gap-3">
          <span class="w-[52px] h-[52px] rounded-full border border-plate-ink text-plate-ink flex items-center justify-center shadow-[inset_0_0_0_4px_#F7F9FF,inset_0_0_0_5px_#0052D6]">
            <Icon name={p.icon as any} size={22} />
          </span>
          <h3 class="text-[19px] font-semibold leading-snug">{p.title}</h3>
          <p class="text-[15.5px] leading-relaxed text-plate-body">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Trois métiers, chacun avec sa vignette gravée -->
  <section id="produit" class="scroll-mt-28 max-w-6xl mx-auto px-4 sm:px-6 pt-14 pb-10">
    <div class="max-w-2xl mb-10">
      <h2 class={`${h2} mb-3`}>Piloter, rester conforme, faire saisir le terrain</h2>
      <p class={lead}>Les trois choses qui vous coûtent du temps et de l'argent aujourd'hui, réunies dans un seul outil.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {pillars.map(p => (
        <article class="bg-white border border-plate-ink flex flex-col">
          <div class="aspect-[9/5] bg-plate-ink border-b border-plate-ink overflow-hidden">
            <img src={p.img} alt={p.alt} width="900" height="400" loading="lazy" class="block w-full h-full object-cover" />
          </div>
          <div class="p-6 flex flex-col gap-2.5 flex-1">
            <h3 class="text-xl font-semibold">{p.title}</h3>
            <p class="text-[15.5px] leading-relaxed text-plate-body">{p.desc}</p>
            <ul class="mt-auto pt-3 space-y-2">
              {p.points.map(pt => (
                <li class="flex items-start gap-2 text-sm text-plate-body"><Icon name="check" size={15} class="text-plate-ink flex-shrink-0 mt-0.5" />{pt}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Planche II : l'application en mouvement -->
  <section data-own-motion class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <figure class="m-0">
      <div class={plate}>
        <div class={`${plateInner} overflow-hidden`}>
          <video
            id="home-film"
            class="block w-full aspect-[4/5] sm:aspect-video object-cover bg-plate-tint"
            muted loop playsinline preload="metadata"
            poster="/hero/fleetdesk-hero-poster.jpg"
            aria-label="Démonstration FleetDesk : une échéance de contrôle technique, puis une visite médicale, puis une vidange arrivent, chacune réglée en un geste ; le tableau de bord repasse à « Tout est à jour »."
          >
            <source media="(max-width: 639px)" src="/hero/fleetdesk-hero-portrait.mp4" type="video/mp4" />
            <source src="/hero/fleetdesk-hero.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
      <figcaption class={caption}>
        <span>PLANCHE II · LE TABLEAU DE BORD</span>
        <span>Ce que vous voyez chaque matin, en un coup d'œil</span>
      </figcaption>
    </figure>
  </section>

  <!-- Comment ça marche : trois étapes à la verticale, chacune avec son exemple animé -->
  <section id="comment" class="scroll-mt-28 max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="mb-12">
      <h2 class={`${h2} mb-2`}>Opérationnel en 5 minutes</h2>
      <p class={lead}>Aucune intégration, aucune formation. Vous êtes prêt avant la fin de votre café.</p>
    </div>
    <ol class="border-l-2 border-dashed border-plate-ink ml-[26px] flex flex-col gap-14">

      <li class="relative pl-10 sm:pl-14 grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-10 items-center">
        <span class="absolute -left-[27px] top-0 w-[52px] h-[52px] rounded-full bg-plate-paper border-[1.5px] border-plate-ink text-plate-ink text-[22px] font-bold flex items-center justify-center">1</span>
        <div class="flex flex-col gap-2.5">
          <span class="text-[12.5px] font-semibold tracking-[0.14em] text-plate-ink">2 MINUTES</span>
          <h3 class="text-[26px] font-semibold">Ajoutez votre flotte</h3>
          <p class="text-base leading-relaxed text-plate-body">Immatriculations, kilométrages, conducteurs : tout est en place en quelques minutes. Aucune formation requise.</p>
        </div>
        <div class={plate} aria-hidden="true">
          <div class={`${plateInner} p-4 sm:p-5 flex flex-col gap-2.5`}>
            <div class="flex justify-between text-[13px]"><span class="font-semibold">Ma flotte</span><span class="text-plate-muted">4 véhicules</span></div>
            <div class="h-1.5 bg-[#E5EEFF] rounded overflow-hidden"><div class="pl-bar h-full w-full bg-plate-ink rounded"></div></div>
            {[
              ['Kangoo',  'AB-123-CD', '84 200 km'],
              ['Partner', 'EF-456-GH', '61 900 km'],
              ['Master',  'IJ-789-KL', '112 000 km'],
              ['Trafic',  'TU-678-VW', '81 600 km'],
            ].map(([model, plateNo, km], i, all) => (
              <div class={`pl-row grid grid-cols-3 text-[13.5px] py-2 ${i < all.length - 1 ? 'border-b border-[#EEF2F9]' : ''}`} style={`animation-delay: ${i * 0.5}s`}>
                <span class="font-semibold">{model}</span><span>{plateNo}</span><span>{km}</span>
              </div>
            ))}
          </div>
        </div>
      </li>

      <li class="relative pl-10 sm:pl-14 grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-10 items-center">
        <span class="absolute -left-[27px] top-0 w-[52px] h-[52px] rounded-full bg-plate-paper border-[1.5px] border-plate-ink text-plate-ink text-[22px] font-bold flex items-center justify-center">2</span>
        <div class="flex flex-col gap-2.5">
          <span class="text-[12.5px] font-semibold tracking-[0.14em] text-plate-ink">1 MINUTE</span>
          <h3 class="text-[26px] font-semibold">Configurez vos alertes</h3>
          <p class="text-base leading-relaxed text-plate-body">Contrôles techniques, documents conducteurs, intervalles d'entretien : choisissez ce que FleetDesk surveille, il le fait à votre place.</p>
        </div>
        <div class={plate} aria-hidden="true">
          <div class={`${plateInner} px-4 sm:px-5 py-2 flex flex-col`}>
            {[
              ['Contrôle technique',        'Alerte 30 jours avant'],
              ['Visite médicale et permis', 'Alerte 30 jours avant'],
              ['Vidange',                   'Tous les 30 000 km'],
            ].map(([t, d], i, all) => (
              <div class={`flex justify-between items-center py-3 ${i < all.length - 1 ? 'border-b border-[#EEF2F9]' : ''}`}>
                <div><div class="text-sm font-semibold">{t}</div><div class="text-[12.5px] text-plate-muted">{d}</div></div>
                <span class="pl-track w-[42px] h-6 rounded-full p-[3px] flex" style={`animation-delay: ${i}s`}>
                  <span class="pl-knob w-[18px] h-[18px] rounded-full bg-white" style={`animation-delay: ${i}s`}></span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </li>

      <li class="relative pl-10 sm:pl-14 grid lg:grid-cols-[1fr_1.15fr] gap-8 lg:gap-10 items-center">
        <span class="absolute -left-[27px] top-0 w-[52px] h-[52px] rounded-full bg-plate-ink text-white text-[22px] font-bold flex items-center justify-center">3</span>
        <div class="flex flex-col gap-2.5">
          <span class="text-[12.5px] font-semibold tracking-[0.14em] text-plate-ink">ENSUITE, TOUT SEUL</span>
          <h3 class="text-[26px] font-semibold">Pilotez sans y penser</h3>
          <p class="text-base leading-relaxed text-plate-body">L'alerte arrive un mois avant l'échéance, par email et dans le tableau de bord. Vous prenez rendez-vous, FleetDesk note que c'est fait.</p>
        </div>
