---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import ContactForm from '../components/ContactForm.jsx'
import Footer from '../components/Footer.astro'
---
<Layout
  title="Contact · FleetDesk"
  description="Une question sur FleetDesk ? Démo, aide pour rester conforme ou pour équiper vos chauffeurs : écrivez-nous, réponse sous 24h ouvrées."
>
  <Navbar client:load currentPath="/contact" />

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-16">

        <!-- Left: info -->
        <div>
          <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-3">Contact</p>
          <h1 class="font-display text-4xl font-semibold text-zinc-900 tracking-tight mb-5">On vous répond sous 24h.</h1>
          <p class="text-lg text-zinc-500 mb-10">
            Piloter votre flotte, rester conforme, équiper vos chauffeurs : dites-nous où vous en êtes, on vous oriente.
          </p>

          <div class="space-y-6">
            {[
              { title: 'Démo du produit',        desc: 'Voir FleetDesk en action et savoir s\'il colle à votre flotte.' },
              { title: 'Conformité & documents', desc: 'De l\'aide pour suivre contrôles techniques, permis et échéances.' },
              { title: 'Équiper vos chauffeurs', desc: 'Mettre en place l\'accès terrain, les rôles et les invitations d\'équipe.' },
            ].map(item => (
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-[#0066FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-zinc-900 mb-1">{item.title}</p>
                  <p class="text-sm text-zinc-500">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-white border border-zinc-200 rounded-2xl p-8">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
