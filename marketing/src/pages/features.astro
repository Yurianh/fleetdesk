---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.jsx'
import CTASection from '../components/CTASection.astro'
import Footer from '../components/Footer.astro'
import { ICONS } from '../lib/icons.js'

const categories = [
  {
    num: '01',
    title: 'Piloter votre flotte',
    promise: 'Chaque véhicule, conducteur et euro dépensé réunis dans une seule source de vérité, mise à jour en temps réel.',
    features: [
      {
        title: 'Registre des véhicules',
        desc: 'Une fiche complète par véhicule : marque, modèle, plaque, statut, kilométrage et historique, en un seul endroit.',
        details: ['Statut en temps réel : actif, en maintenance, hors service', 'Historique complet des événements par véhicule', 'Recherche et filtres par marque, modèle ou plaque'],
        icon: ICONS.truck,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Profils conducteurs',
        desc: 'Fiche complète par conducteur : coordonnées, date de naissance, adresse, cartes carburant et badges.',
        details: ['Téléphone, email, date de naissance et adresse', 'Cartes DKV, badge autoroute, carte lavage', 'Historique des affectations par conducteur'],
        icon: ICONS.users,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Affectations',
        desc: 'Affectez un véhicule à un conducteur, suivez les affectations en cours et passées, gérez les transitions sans confusion.',
        details: ['Vue instantanée : quel véhicule avec quel conducteur', 'Historique daté de toutes les affectations', 'Échange ou désaffectation en un clic'],
        icon: ICONS.assignments,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Suivi kilométrique',
        desc: "Relevés d'odomètre pour un suivi précis, base des prévisions d'entretien. Le kilométrage courant est toujours la valeur la plus élevée.",
        details: ['Saisie rapide du kilométrage par véhicule', 'Garde-fou anti-décroissance sur les relevés', 'Historique chronologique complet'],
        icon: ICONS.gauge,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Historique maintenance',
        desc: 'Consignez chaque entretien, réparation et remplacement de pièces, avec leur coût. Rien ne se perd.',
        details: ['Coût associé à chaque intervention', 'Facture ou justificatif joint', 'Historique par véhicule, daté'],
        icon: ICONS.wrench,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Tableau de bord analytique',
        desc: "Coûts, tendances kilométriques et activité de la flotte, en graphiques clairs. Sans le moindre tableur.",
        details: ['KPIs en temps réel : véhicules actifs, coûts, alertes', 'Utilisation par véhicule sur 3, 6 ou 12 mois', 'Répartition des dépenses par catégorie'],
        icon: ICONS.chart,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
    ],
  },
  {
    num: '02',
    title: 'Rester conforme',
    promise: 'Les échéances réglementaires calculées pour vous, alertées à l\'avance. Plus jamais d\'immobilisation surprise ni de document expiré.',
    features: [
      {
        title: 'Documents conducteurs',
        desc: 'Les 7 documents réglementaires par conducteur : permis de conduire, aptitude à la conduite, casier judiciaire, SST/PSC1, TPMR, visite médicale, éco-conduite.',
        details: ['Calcul automatique des échéances selon la réglementation', 'Regroupés par catégorie, badge de conformité global', 'Alertes segmentées : expirés, bientôt, manquants'],
        icon: ICONS.idCard,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Documents du véhicule',
        desc: 'Carte grise, attestation d\'assurance et licence de transport, attachées à chaque véhicule et accessibles en un clic.',
        details: ['Photo ou PDF, compressés automatiquement', 'Stockés en privé, jamais en accès public', 'Toujours à portée pour un contrôle'],
        icon: ICONS.document,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Contrôles techniques',
        desc: "Dates de contrôle, résultats et prochaines échéances. Restez en conformité, évitez l'immobilisation coûteuse.",
        details: ['Résultat enregistré : favorable ou contre-visite', 'Rappels automatiques avant expiration', 'Vue consolidée des véhicules à renouveler'],
        icon: ICONS.inspection,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Prévision de maintenance',
        desc: "FleetDesk anticipe l'entretien selon la cadence kilométrique réelle et le temps, et vous prévient avant la casse.",
        details: ['Projection par kilomètres restants ou par date', 'Liste priorisée des véhicules à traiter', 'Seuil d\'alerte 5 000 km avant échéance'],
        icon: ICONS.calendarClock,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Centre d\'alertes',
        desc: "Documents, contrôles techniques et entretiens à échéance, priorisés en un seul endroit. Vous voyez ce qui demande une action.",
        details: ['Priorité : action immédiate ou à surveiller', 'Véhicules et conducteurs réunis', 'Chaque échéance détectée avant qu\'il soit trop tard'],
        icon: ICONS.bell,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Alertes par email',
        desc: "Vous n'avez pas à ouvrir FleetDesk pour savoir ce qui arrive : le récapitulatif des échéances des 30 prochains jours vous parvient par email.",
        details: [
          'Contrôles techniques, documents conducteurs et entretiens réunis',
          'Une fois par semaine au plus — sauf si une échéance passe sous 7 jours',
          'Aucun email si votre flotte n\'a rien à traiter',
        ],
        icon: ICONS.document,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
    ],
  },
  {
    num: '03',
    title: 'Faire saisir le terrain',
    promise: 'Vos chauffeurs saisissent kilométrage, pleins et lavages depuis leur téléphone. Vous récupérez tout, sans ressaisie.',
    features: [
      {
        title: 'Accès chauffeur',
        desc: "Un accès dédié pour chaque chauffeur, limité à son véhicule. Simple, mobile, sans risque de fausse manip sur le reste de la flotte.",
        details: ['Véhicule pré-sélectionné et verrouillé', 'Interface réduite à l\'essentiel', 'Aucun accès aux données des autres'],
        icon: ICONS.smartphone,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Saisie au poste de conduite',
        desc: "Au moment du plein, le chauffeur note le kilométrage, ajoute un libellé et photographie la facture. Vous récupérez tout, sans ressaisie.",
        details: ['Kilométrage, libellé et preuve de facture', 'Conducteur et carte DKV rappelés à l\'écran', 'Photos compressées automatiquement'],
        icon: ICONS.pencil,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Suivi des lavages',
        desc: "Date, type et coût de chaque lavage, avec justificatif. Un détail qui compte pour les flottes soucieuses de leur image.",
        details: ['Saisi en un geste par le chauffeur', 'Facture ou justificatif joint', 'Suivi de la fréquence et des dépenses par véhicule'],
        icon: ICONS.droplets,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
      {
        title: 'Rôles & permissions',
        desc: "Propriétaire, administrateur, membre, chauffeur : chacun voit ce qui le concerne. Invitez votre équipe par email en quelques secondes.",
        details: ['Quatre niveaux d\'accès, appliqués côté serveur', 'Invitations par email, activation en un clic', 'Admins et membres deviennent aussi conducteurs'],
        icon: ICONS.shield,
        bg: 'bg-blue-50', color: 'text-[#0066FF]', accentBg: 'bg-[#0066FF]',
      },
    ],
  },
]

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://fleetdesk.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Fonctionnalités', item: 'https://fleetdesk.fr/features' },
  ],
}
---
<Layout
  jsonLd={[breadcrumb]}
  title="Fonctionnalités de gestion de flotte"
  description="Piloter la flotte, rester conforme, faire saisir le terrain : véhicules, documents réglementaires, contrôles techniques, prévisions d'entretien et saisie chauffeur."
>
  <Navbar client:load currentPath="/features" />

  <!-- Header -->
  <section class="bg-white border-b border-zinc-100 pt-20 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="text-sm font-semibold text-[#0066FF] tracking-wide mb-4">Fonctionnalités</p>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-semibold text-zinc-900 tracking-tight leading-[1.05] max-w-3xl mb-6">
        Piloter, rester conforme,<br class="hidden sm:block" /> faire saisir le terrain.
      </h1>
      <p class="text-lg text-zinc-600 max-w-2xl leading-relaxed">
        Tout le cycle de gestion de flotte, de la fiche véhicule à la conformité réglementaire, jusqu'à la saisie par vos chauffeurs. Sans formation, sans intégration.
      </p>
    </div>
  </section>

  <!-- Feature pillars — editorial index -->
  {categories.map((cat, i) => (
    <section class={i % 2 === 1 ? 'bg-zinc-50' : 'bg-white'}>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-24 grid md:grid-cols-[0.55fr_1fr] gap-x-16 gap-y-10">
        <!-- Pillar label (sticky on desktop) -->
        <div class="md:sticky md:top-28 self-start">
          <span class="block font-display text-7xl sm:text-8xl font-semibold text-zinc-900/[0.07] leading-none select-none tabular-nums">{cat.num}</span>
          <h2 class="font-display text-3xl font-semibold text-zinc-900 tracking-tight mt-3 mb-4">{cat.title}</h2>
          <p class="text-[15px] text-zinc-600 leading-relaxed max-w-sm">{cat.promise}</p>
        </div>

        <!-- Feature rows -->
        <div class="divide-y divide-zinc-200/70">
          {cat.features.map(f => (
            <div class="py-7 first:md:pt-0 flex gap-5">
              <span class="flex-shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-[#0066FF]/[0.06]">
                <svg class="w-[22px] h-[22px] text-[#0066FF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </span>
              <div class="min-w-0">
                <h3 class="text-lg font-semibold text-zinc-900 tracking-tight mb-1.5">{f.title}</h3>
                <p class="text-sm text-zinc-600 leading-relaxed mb-3">{f.desc}</p>
                <ul class="flex flex-wrap gap-x-5 gap-y-1.5">
                  {f.details.map(d => (
                    <li class="flex items-center gap-1.5 text-xs text-zinc-500">
                      <svg class="w-3.5 h-3.5 text-[#0066FF] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {d}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTASection />
  <Footer />
</Layout>
